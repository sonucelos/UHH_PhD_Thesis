@article{atia-tul-noor_sub-50_2024,
	title = {Sub-50 fs temporal resolution in an {FEL}-optical laser pump-probe experiment at {FLASH2}},
	volume = {32},
	url = {https://opg.optica.org/oe/abstract.cfm?URI=oe-32-4-6597},
	doi = {10.1364/OE.513714},
	abstract = {High temporal resolution is essential for ultra-fast pump-probe experiments. Arrival time jitter and drift measurements, as well as their control, become critical especially when combining XUV or X-ray free-electron lasers (FELs) with optical lasers due to the large scale of such facilities and their distinct pulse generation processes. This paper presents the application of a laser pulse arrival time monitor that actively corrects the arrival time of an optical laser relative to the FEL\&\#x2019;s main optical clock. Combined with post-analysis single pulse jitter correction this new approach improves the temporal resolution for pump-probe experiments significantly. Benchmark measurements on photo-ionization of xenon atoms performed at FLASH beamline FL26, demonstrate a sub-50 fs FWHM overall temporal resolution.},
	number = {4},
	journal = {Opt. Express},
	author = {{Atia-tul-noor} and Kumar, Sonu and Schirmel, Nora and Erk, Benjamin and Manschwetus, Bastian and Alisaukas, Skirmantas and Braune, Markus and Cirmi, Giovanni and Czwalinna, Marie Kristin and Frühling, Ulrike and Grosse-Wortmann, Uwe and Kschuev, Nick and Kuschewski, Frederik and Lang, Tino and Lindenblatt, Hannes and Litvinyuk, Igor and Meister, Severin and Moshammer, Robert and Papadopoulou, Christina C. and Passow, Christopher and Roensch-Schulenburg, Juliane and Trost, Florian and Hartl, Ingmar and Düsterer, Stefan and Schulz, Sebastian},
	month = feb,
	year = {2024},
	note = {Publisher: Optica Publishing Group},
	keywords = {Laser applications, Laser sources, Optical clocks, Ultrafast lasers, X-ray lasers, X-ray spectroscopy},
	pages = {6597--6608},
}


